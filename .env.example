# =================================================================
# EMRICH GESTOR - EMPRESA MUNICIPAL DO RIO CHIVEVE (BEIRA, MOÇAMBIQUE)
# VARIÁVEIS DE AMBIENTE E SEGREDO (SECRETS)
# =================================================================

# GEMINI_API_KEY: Chave para chamadas à API do Google Gemini AI (Análises preditivas e diagnósticos)
GEMINI_API_KEY=

# APP_URL: URL oficial da aplicação EMRICH GESTOR
APP_URL=

# -----------------------------------------------------------------
# SUPABASE (BASE DE DADOS, AUTENTICAÇÃO E STORAGE)
# -----------------------------------------------------------------
# VITE_SUPABASE_URL: URL do seu projeto Supabase (ex: https://xyz.supabase.co)
VITE_SUPABASE_URL=

# VITE_SUPABASE_ANON_KEY: Chave pública anónima (anon key) do Supabase para acesso do cliente
VITE_SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY: Chave do serviço Supabase (apenas para ambiente de servidor seguro)
SUPABASE_SERVICE_ROLE_KEY=

# DATABASE_URL: String de conexão PostgreSQL direta do Supabase (ex: postgresql://postgres:senha@db.xyz.supabase.co:5432/postgres)
DATABASE_URL=

# -----------------------------------------------------------------
# WHATSAPP DIRECT LINKING (SEM API PAGA)
# -----------------------------------------------------------------
# A aplicação utiliza links directos "https://wa.me/<numero>?text=<mensagem>" 
# para abertura direta no WhatsApp Web / App nativo, sem necessidade de credenciais de API.

# -----------------------------------------------------------------
# GOOGLE MAPS PLATFORM / GEOLOCALIZAÇÃO
# -----------------------------------------------------------------
# VITE_GOOGLE_MAPS_API_KEY: Chave para mapas interativos do Rio Chiveve, canais e eclusas
VITE_GOOGLE_MAPS_API_KEY=


